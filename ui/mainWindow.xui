
mainWindow = Window([0, 0, width, height]) [] {
    !loadPreset();
    .topBar = () <> {};
    .rightBar = () <> {};
    .bottomBar = () <> {};
    .leftBar = () <> {};
    .central = () <
        fileExplorer = Widget(0, 0, 0.3 * width, height) { };
        $(var i = 0; i < 7; i++) [
             editor##i = Widget(0, ., width, ) { };
        ] { ..count = 1 + i; }
    > {};
    .title = f"xIDE - {.projectName}";
}
